          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();\r\n\r\npm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Response contains a Gist ID\", function () {\r\n    pm.expect(jsonData.id).to.exist;\r\n});\r\n\r\npm.test(\"Gist description is correct\", function () {\r\n    pm.expect(jsonData.description)\r\n        .to.eql(\"Postman API Assignment - CRUD Testing\");\r\n});\r\n\r\nif (jsonData.id) {\r\n    pm.environment.set(\"gist_id\", jsonData.id);\r\n}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{auth_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"description\": \"Postman API Assignment - CRUD Testing\",\r\n    \"public\": false,\r\n    \"files\": {\r\n        \"assignment.txt\": {\r\n            \"content\": \"This Gist was created using the GitHub REST API and Postman.\"\r\n        }\r\n    }\r\n}",
          "options": {
            "raw": {
              "language": "json"
