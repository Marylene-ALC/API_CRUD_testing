  "item": [
    {
      "name": "Verify Authentication",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();\r\n\r\npm.test(\"Authentication successful - Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contains GitHub username\", function () {\r\n    pm.expect(jsonData.login).to.exist;\r\n});\r\n\r\npm.test(\"Response contains user ID\", function () {\r\n    pm.expect(jsonData.id).to.exist;\r\n});\r\n\r\npm.test(\"Authenticated user type is valid\", function () {\r\n    pm.expect(jsonData.type).to.exist;\r\n});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{auth_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/user",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "user"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Gist",
      "event": [
