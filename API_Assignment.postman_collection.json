            "exec": [
              "const jsonData = pm.response.json();\r\n\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Returned Gist ID matches environment variable\", function () {\r\n    pm.expect(jsonData.id).to.eql(pm.environment.get(\"gist_id\"));\r\n});\r\n\r\npm.test(\"Gist contains assignment.txt\", function () {\r\n    pm.expect(jsonData.files).to.have.property(\"assignment.txt\");\r\n});"
            ]
          }
        }
